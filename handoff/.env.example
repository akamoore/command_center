# ============================================================================
# Command Center — consolidated environment variables (HANDOFF reference)
# ============================================================================
# Copy to `.env` at the repo root and fill in YOUR values.
# NEVER commit .env — it is gitignored. Each value below is currently tied to the
# original owner's accounts; see handoff/MIGRATION.md for what each one repoints to.

# --- NEW: your database (for the participant/lead/wearable data migration) -----
# Used by handoff/migration/import-data.mjs. Supabase: Settings -> Database -> URI.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Operations / recruiting API (the dashboard's live data backend) -----------
# Today: operations.reputablehealth.net. Repoint API_HOST to YOUR backend, and
# set YOUR key. NOTE: the previous key was hardcoded in 4 HTML files and is
# considered compromised — rotate it. (MIGRATION.md, step 1.)
API_HOST=your-operations-api-host
API_KEY=your-ops-api-key-here

# --- Data-feed sources (scripts/refresh-stats.mjs + GitHub Actions) ------------
# Meta Ads (Graph API). META_AD_ACCOUNT_ID was act_2045754205850315 (the owner's).
META_ACCESS_TOKEN=your-meta-graph-api-token
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX
# AppsFlyer (Pull API). APPSFLYER_APP_ID was id6451213618 (the owner's app).
APPSFLYER_API_TOKEN=your-appsflyer-pull-api-token
APPSFLYER_APP_ID=idXXXXXXXXXX
# SendGrid (email stats + the email-proxy send/webhook service)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# --- AI sub-apps (trending-topic-generator, script-generator) ------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key   # build-time key for the Vite apps

# --- email-proxy (optional — only if you run the SendGrid send service) --------
DEFAULT_FROM_EMAIL=community@your-domain.com
DEFAULT_FROM_NAME=Your Brand
SENDGRID_UNSUB_GROUP_ID=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Local proxies (api-proxy / email-proxy) -----------------------------------
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Deploy / ops (optional) ---------------------------------------------------
SLACK_WEBHOOK_URL=your-slack-webhook   # deploy + daily-summary notifications
VERCEL_TOKEN=your-vercel-token         # if deploying via CLI in CI
